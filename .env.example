# Rosetta Research Agent - Environment Variables
# Copy to .env and fill in values.

# REQUIRED: At minimum, enables US + Crypto desks
GROQ_API_KEY=

# OPTIONAL: Enables additional desks
DEEPSEEK_API_KEY=          # China desk (native Mandarin reasoning)
GOOGLE_API_KEY=            # EU + Japan desks (Gemini)
TUSHARE_TOKEN=             # Premium A-share data
FINANCIAL_DATASETS_API_KEY= # SEC filings for US desk

# FEATURE FLAGS
ENABLE_IPFS=false          # Set to "true" to pin traces to IPFS
ENABLE_ONCHAIN=false       # Set to "true" for Arc L1 recording

# IPFS (only needed if ENABLE_IPFS=true)
PINATA_JWT=
STORACHA_SIDECAR_URL=http://localhost:3030

# ON-CHAIN (only needed if ENABLE_ONCHAIN=true)
ARC_RPC_URL=https://rpc.testnet.arc.network
REASONING_REGISTRY_ADDRESS=
ARC_DEPLOYER_PRIVATE_KEY=

# SERVER
PORT=8000
ENV=production
